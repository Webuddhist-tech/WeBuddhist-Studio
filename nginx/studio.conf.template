server {
  listen 4173;
  server_name localhost;
  proxy_http_version 1.1;
  client_max_body_size 50m;

  root /usr/share/nginx/html;

  index index.html;

  location / {
      try_files $uri $uri/ /index.html;
      include /etc/nginx/security-headers.conf;
  }

  # The live-control socket: nginx passes a WebSocket through only when told to
  # carry the upgrade, and holds it open for a whole puja, not five minutes.
  location ~ ^/api/v1/events/[^/]+/recitation/live$ {
      proxy_pass ${VITE_BACKEND_BASE_URL};
      proxy_ssl_server_name on;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 4h;
      proxy_send_timeout 4h;
  }

  location /api {
      proxy_pass ${VITE_BACKEND_BASE_URL};
      proxy_ssl_server_name on;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
  }

  # The library (OpenPecha) API, behind our own origin: its host never appears in
  # a browser request and the X-Application header it requires is added here
  # rather than shipped in the bundle. Mirrors the /library proxy in vite.config.ts.
  location /library/ {
      rewrite ^/library/(.*)$ /$1 break;
      proxy_pass ${VITE_LIBRARY_BASE_URL};
      proxy_set_header X-Application ${VITE_LIBRARY_APP_NAME};
      proxy_ssl_server_name on;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
  }
}
